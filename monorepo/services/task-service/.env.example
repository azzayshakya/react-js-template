NODE_ENV=development
PORT=5001

MONGO_URI=mongodb://127.0.0.1:27017/taskdb
REDIS_URL=redis://127.0.0.1:6379

KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_CA_CERT_PATH=./certs/ca.pem

# JWT - always available, no ENABLED toggle needed
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
JWT_ISSUER=task-service

# Mail (SMTP - works with Mailjet, Gmail, SES, etc.)
MAIL_ENABLED=false
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Your App <no-reply@yourapp.com>"

# Cloudinary
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=uploads

# Gemini
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
